        "dockerfilePath": "Dockerfile.postgres"
      },
      "deploy": {
        "startCommand": null,
        "healthcheckPath": null,
        "healthcheckTimeout": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "repo": "https://github.com/nomideusz/datalens-railway",
        "rootDirectory": "/"
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {
        "a196d325-a23a-427a-b4fe-02d7b4997adf": {
          "mountPath": "/var/lib/postgresql/data"
        }
      },
      "variables": {
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Password of the pg-user superuser",
          "isOptional": false
        },
        "DATALENS_KEY_SEED": {
          "defaultValue": "${{secret(64, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Seed every service derives its signing keys, master tokens and the connection-password encryption key from. Never change it after the first boot",
