{
  "services": {
    "8e2dcd29-3e9b-4a66-89ad-ab950240799c": {
      "icon": "https://raw.githubusercontent.com/nomideusz/datalens-railway/main/icon.svg",
      "name": "DataLens",
      "build": {
        "dockerfilePath": "Dockerfile.ui"
      },
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/ping",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "repo": "https://github.com/nomideusz/datalens-railway",
        "rootDirectory": "/"
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>": {}
        }
      },
      "volumeMounts": {},
      "variables": {
        "PORT": {
          "defaultValue": "8080",
          "description": "Port the service listens on - leave as is",
          "isOptional": false
        },
        "DATALENS_ADMIN_PASSWORD": {
          "defaultValue": "${{secret(24, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Password for the admin user (login: admin). Applied on first boot only; change it later in DataLens",
          "isOptional": false
        },
        "DATALENS_KEY_SEED": {
          "defaultValue": "${{Postgres.DATALENS_KEY_SEED}}",
          "description": "Shared seed the service derives its keys and tokens from (set on Postgres)",
          "isOptional": false
        },
        "US_ENDPOINT": {
          "defaultValue": "http://${{US.RAILWAY_PRIVATE_DOMAIN}}:8080",
          "description": "United Storage on the private network",
          "isOptional": false
        },
        "AUTH_ENDPOINT": {
          "defaultValue": "http://${{Auth.RAILWAY_PRIVATE_DOMAIN}}:8080",
          "description": "Auth service on the private network",
          "isOptional": false
        },
        "BI_API_ENDPOINT": {
          "defaultValue": "http://${{ControlAPI.RAILWAY_PRIVATE_DOMAIN}}:8080",
          "description": "Control API on the private network",
          "isOptional": false
        },
        "BI_DATA_ENDPOINT": {
          "defaultValue": "http://${{DataAPI.RAILWAY_PRIVATE_DOMAIN}}:8080",
          "description": "Data API on the private network",
          "isOptional": false
        }
      }
    },
    "c7fe2c27-baf1-4f07-85ce-7310a2121fb3": {
